# === 本地配置说明 ===
# 不要把真实密钥写进这个文件；.env.example 会提交到仓库。
# 推荐的本地密钥位置：
#   Windows: C:\Users\<你的用户名>\.mybot\.env
#   macOS/Linux: ~/.mybot/.env
# 也可以设置 MYBOT_ENV_FILE 指向仓库外的任意配置文件。
# 读取优先级：MYBOT_ENV_FILE > 项目根目录 .env > 用户目录 ~/.mybot/.env

# === LLM 配置（OpenAI 兼容接口）===
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === Agent 行为配置 ===
MAX_STEPS=10          # ReAct 循环单轮最大步数
TEMPERATURE=0.0       # 采样温度

# === 记忆模块配置 ===
MEMORY_ENABLED=true
# 记忆运行数据根目录（会话、Chroma）；留空则使用项目内 data/
MEMORY_DATA_DIR=
# 短期记忆：消息条数超过该值即触发摘要压缩；压缩后保留最近这么多条
MEMORY_MAX_MESSAGES=30
MEMORY_KEEP_RECENT=10
# 长期记忆：每轮检索的条数
MEMORY_TOP_K=3
# 以下两项留空则从 MEMORY_DATA_DIR 自动推导
MEMORY_SESSIONS_DIR=
MEMORY_CHROMA_DIR=
# 嵌入模型目录；留空则使用项目内 models/bge-small-zh-v1.5
MEMORY_MODEL_DIR=

# === 邮件 MCP 配置（只发件；收件人白名单由邮件服务自身强制执行）===
# 重要：SMTP/IMAP 授权码不要写进本文件，也不要提交到 Git。
# 当前 mcp-email-server 将账号凭据保存在它自己的本地配置库中。
# 首次配置请运行：
#   uvx mcp-email-server@latest ui
# 然后在本地 UI 中填写（以下仅为字段示例，不是真实值）：
#   账号名称：qq
#   邮箱地址：your-account@qq.com
#   SMTP：smtp.qq.com:465（SSL）
#   IMAP：imap.qq.com:993（SSL）
#   授权码：your-16-char-auth-code
MCP_EMAIL_ENABLED=false   # 配置好邮件授权码后再改为 true
# 启动 MCP 服务的命令行（uvx 已安装；首次运行会下载包，较慢）
MCP_EMAIL_COMMAND=uvx mcp-email-server@latest stdio
# 只把这些 MCP 工具暴露给模型（逗号分隔）；默认只暴露发件工具
MCP_EMAIL_TOOLS=send_email
# send_email 的 account_name 默认值，需与邮件服务里配置的账号名一致
MCP_EMAIL_ACCOUNT=qq
# 启动握手与单次调用超时（秒）
MCP_EMAIL_TIMEOUT=60

# === Web API 配置 ===
# 只监听本机；如需局域网访问改成 0.0.0.0（注意安全风险）
API_HOST=127.0.0.1
API_PORT=8000

# 可选的本地配置路径（示例，不要提交真实值）：
# MYBOT_ENV_FILE=C:\Users\your-name\.mybot\.env